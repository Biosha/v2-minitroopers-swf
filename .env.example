# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://eternaltwin.dev.admin:dev@localhost:5432/minitroopers?schema=public"

NODE_ENV="development"
PORT=3000
SELF_URL="http://localhost:4200"

ETERNALTWIN_URL="http://localhost:50321/"
ETERNALTWIN_CLIENT_ID="minitroopers@clients"
ETERNALTWIN_CLIENT_SECRET="dev"

# Log SQL queries (default false; do not enable in production)
DEBUG_QUERIES=false

# Game limits are enforced in production; set true to disable in dev
DISABLE_GAME_LIMITS=true

# Path to client_fr_edit.swf used by Ruffle battle simulation
SWF_PATH=""

# Set true behind a reverse proxy in production
TRUST_PROXY=false

MAX_CONCURRENT=20
TIMEOUT=35000
