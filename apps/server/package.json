{
  "name": "@minitroopers/server",
  "version": "0.0.2",
  "scripts": {
    "lint": "eslint src/**/*.ts",
    "copy-bin": "copyfiles -u 1 \"src/bin/**/*\" ../../build",
    "write-build-pkg": "node -e \"require('fs').writeFileSync('../../build/package.json', JSON.stringify({ type: 'module' }))\"",
    "start-dist": "npm run copy-bin && npm run write-build-pkg && node ../../build/main.js",
    "build": "tsc --build ./tsconfig.json && npm run copy-bin && npm run write-build-pkg",
    "dev": "tsc-watch --build ./tsconfig.json --onSuccess \"npm run start-dist\""
  },
  "type": "module",
  "dependencies": {
    "@eternaltwin/client-node": "^0.14.1",
    "@eternaltwin/core": "^0.14.2",
    "@eternaltwin/oauth-client-http": "^0.14.2",
    "@minitroopers/prisma": "*",
    "@minitroopers/shared": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "compression": "^1.8.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "node-schedule": "^2.1.1",
    "pg": "^8.16.3",
    "url-join": "^5.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "@types/node-schedule": "^2.1.7",
    "@types/pg": "^8.15.5",
    "copyfiles": "^2.4.1",
    "prisma": "^7.10.0",
    "ts-node": "^10.9.2",
    "tsc-watch": "^6.2.0",
    "typescript": "~6.0.0"
  }
}
